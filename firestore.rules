rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isTenantOwner(tenantId) {
      return isSignedIn() && request.auth.uid == tenantId;
    }

    match /platformTenants/{id} {
      allow read, write: if false;
    }
    match /platformRateLimits/{id} {
      allow read, write: if false;
    }

    match /tenants/{tenantId} {
      match /settings/{docId} {
        allow read: if true;
        allow create, update, delete: if isTenantOwner(tenantId) && docId == 'config';
      }

      match /services/{serviceId} {
        allow read: if true;
        allow create, update, delete: if isTenantOwner(tenantId);
      }

      match /appointments/{appointmentId} {
        allow read: if isTenantOwner(tenantId);
        allow create, update, delete: if false;
      }

      match /blockedSlots/{id} {
        allow read, write: if isTenantOwner(tenantId);
      }

      match /staff/{staffId} {
        allow read: if true;
        allow write: if isTenantOwner(tenantId);
      }

      match /notifications/{id} {
        allow read, write: if isTenantOwner(tenantId);
      }

      match /closureEvents/{id} {
        allow read: if isTenantOwner(tenantId);
        allow write: if false;
      }

      match /idempotency/{id} {
        allow read, write: if false;
      }

      match /customers/{customerId} {
        allow read: if isTenantOwner(tenantId);
        allow write: if false;
      }

      match /waitlist/{id} {
        allow read: if isTenantOwner(tenantId);
        allow write: if false;
      }

      match /slotOffers/{id} {
        allow read: if isTenantOwner(tenantId);
        allow write: if false;
      }

      match /aiCache/{id} {
        allow read, write: if false;
      }
      match /usage/{id} {
        allow read, write: if false;
      }
      match /pushSubs/{id} {
        allow read, write: if isTenantOwner(tenantId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
