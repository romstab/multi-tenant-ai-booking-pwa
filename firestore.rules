rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isTenantOwner(tenantId) {
      return isSignedIn() && request.auth.uid == tenantId;
    }

    // Server-only (Firebase Admin SDK)
    match /platformTenants/{id} {
      allow read, write: if false;
    }
    match /platformRateLimits/{id} {
      allow read, write: if false;
    }

    match /tenants/{tenantId} {
      // Public business profile (hours, theme, emergency message). No customer PII here.
      match /settings/{docId} {
        allow read: if true;
        allow create, update, delete: if isTenantOwner(tenantId) && docId == 'config';
      }

      // Public service catalog
      match /services/{serviceId} {
        allow read: if true;
        allow create, update, delete: if isTenantOwner(tenantId);
      }

      // Appointments: owner may READ only. All creates/updates go through Admin SDK
      // (/api/create-booking) so status transitions and conflicts stay server-enforced.
      match /appointments/{appointmentId} {
        allow read: if isTenantOwner(tenantId);
        allow create, update, delete: if false;
      }

      match /blockedSlots/{id} {
        allow read: if isTenantOwner(tenantId);
        // Prefer API, but owner client write is still tenant-scoped
        allow create, update, delete: if isTenantOwner(tenantId);
      }

      match /staff/{staffId} {
        allow read: if true;
        allow write: if isTenantOwner(tenantId);
      }

      match /notifications/{id} {
        allow read, update: if isTenantOwner(tenantId);
        allow create, delete: if isTenantOwner(tenantId);
      }

      match /closureEvents/{id} {
        allow read: if isTenantOwner(tenantId);
        allow write: if false;
      }

      match /idempotency/{id} {
        allow read, write: if false;
      }

      match /aiCache/{id} {
        allow read, write: if false;
      }
      match /usage/{id} {
        allow read, write: if false;
      }
      match /pushSubs/{id} {
        allow read, write: if isTenantOwner(tenantId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
